# Literary Voices Network (LVN) — Environment Configuration Example
# Copy this file to .env.local and supply production values where applicable.

# Application URL & Security
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LVN_SESSION_SECRET="replace-with-at-least-32-bytes-cryptographic-secret-key"

# Database Configuration
# For local development without an external Postgres daemon, leave DATABASE_URL unset
# and LVN will automatically use the persistent local database at ./data/lvn.sqlite
# For production PostgreSQL / Supabase, set DATABASE_URL:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
DATABASE_URL=""
LVN_SQLITE_PATH="./data/lvn.sqlite"

# Optional Supabase Auth & Storage Integration
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="lvn-media"

# Optional Email Delivery Integration (Resend / SMTP)
# When unset, LVN runs in safe development outbox mode and records all transactional emails in the database/outbox log without sending external emails.
RESEND_API_KEY=""
EMAIL_FROM="Literary Voices Network <editorial@literaryvoicesnetwork.org>"

# Optional Live Broadcast & Podcast Provider Configuration
NEXT_PUBLIC_DEFAULT_PODCAST_URL=""
NEXT_PUBLIC_LIVE_STREAM_HLS_URL=""

